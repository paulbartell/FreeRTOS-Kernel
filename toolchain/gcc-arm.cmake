# File Extensions
# C Source File: .c
# C Header File: .h
# ASM file without preprocessing: .s
# ASM file with preprocessing step: .S

# Determine Toolchain binary path
if(DEFINED TOOLCHAIN_PATH)
    set(TC_BIN_PATH ${TOOLCHAIN_PATH}/bin/)
else()
    set(TC_BIN_PATH "")
endif()

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

if(${CONFIG_TOOLCHAIN_PREFIX})
    set(TC_PREFIX ${CONFIG_TOOLCHAIN_PREFIX})
else()
    set(TC_PREFIX arm-none-eabi-)
endif()

if(${CONFIG_ARM_CORE_ARM7TDMI})
    set(GCC_M_CPU arm7tdmi)
    # ?? arm7tdmi-s ??
elseif(${CONFIG_ARM_CORE_ARM926EJ_S})
    set(GCC_M_CPU arm926ej-s)
elseif(${CONFIG_ARM_CORE_CORTEX_MO})
    set(GCC_M_CPU cortex-m0)
elseif(${CONFIG_ARM_CORE_CORTEX_MO_PLUS})
    set(GCC_M_CPU cortex-m0plus)
elseif(${CONFIG_ARM_CORE_CORTEX_M1})
    set(GCC_M_CPU cortex-m1)
elseif(${CONFIG_ARM_CORE_CORTEX_M3})
    set(GCC_M_CPU cortex-m3)
elseif(${CONFIG_ARM_CORE_CORTEX_M4})
    set(GCC_M_CPU cortex-m4)
elseif(${CONFIG_ARM_CORE_CORTEX_M7})
    set(GCC_M_CPU cortex-m7)
elseif(${CONFIG_ARM_CORE_CORTEX_M23})
    set(GCC_M_CPU cortex-m23)
elseif(${CONFIG_ARM_CORE_CORTEX_M33})
    set(GCC_M_CPU cortex-m33)
elseif(${CONFIG_ARM_CORE_CORTEX_M35P})
    set(GCC_M_CPU cortex-m35p)
elseif(${CONFIG_ARM_CORE_CORTEX_M55})
    set(GCC_M_CPU cortex-m55)
elseif(${CONFIG_ARM_CORE_CORTEX_R4})
    set(GCC_M_CPU cortex-r4)
    # ?? when to choose cortex-r4f ??
elseif(${CONFIG_ARM_CORE_CORTEX_R5})
    set(GCC_M_CPU cortex-r5)
elseif(${CONFIG_ARM_CORE_CORTEX_R7})
    set(GCC_M_CPU cortex-r7)
elseif(${CONFIG_ARM_CORE_CORTEX_R8})
    set(GCC_M_CPU cortex-r8)
else()
    # Target a generic core for the architecture
    if(${CONFIG_TARGET_ARCH_ARMV4T})
        set(GCC_M_ARCH armv4t)
    elseif(${CONFIG_TARGET_ARCH_ARMV5TE})
        set(GCC_M_ARCH armv5te)
    elseif(${CONFIG_TARGET_ARCH_ARMV6M})
        set(GCC_M_ARCH armv6-m)
    elseif(${CONFIG_TARGET_ARCH_ARMV7A})
        set(GCC_M_ARCH armv7-a)
    elseif(${CONFIG_TARGET_ARCH_ARMV7M})
        set(GCC_M_ARCH armv7-m)
    elseif(${CONFIG_TARGET_ARCH_ARMV7EM})
        set(GCC_M_ARCH armv7e-m)
    elseif(${CONFIG_TARGET_ARCH_ARMV7R})
        set(GCC_M_ARCH armv7-r)
    elseif(${CONFIG_TARGET_ARCH_ARMV8A})
        set(GCC_M_ARCH armv8-a)
    elseif(${CONFIG_TARGET_ARCH_ARMV8M_BASE})
        set(GCC_M_ARCH armv8-m.base)
    elseif(${CONFIG_TARGET_ARCH_ARMV8M})
        set(GCC_M_ARCH armv8-m.main+dsp+fp)
    endif()
endif()

if(${CONFIG_TARGET_NO_FPU})
    set(GCC_M_FPU "")
elseif(${CONFIG_TARGET_ARM_FPU_VFPV3_D32})
    set(GCC_M_FPU vfpv3)
elseif(${CONFIG_TARGET_ARM_FPU_VFPV3_D32_FP16})
    set(GCC_M_FPU vfpv3-fp16)
elseif(${CONFIG_TARGET_ARM_FPU_VFPV3_D16})
    set(GCC_M_FPU vfpv3-d16)
elseif(${CONFIG_TARGET_ARM_FPU_VFPV3_D16_FP16})
    set(GCC_M_FPU vfpv3-d16-fp16)
elseif(${CONFIG_TARGET_ARM_FPU_VFPV4})
    set(GCC_M_FPU vfpv4)
elseif(${CONFIG_TARGET_ARM_FPU_VFPV4_D16})
    set(GCC_M_FPU vfpv4-d16)
elseif(${CONFIG_TARGET_ARM_FPU_FPV4_SP})
    set(GCC_M_FPU fpv4-sp-d16)
elseif(${CONFIG_TARGET_ARM_FPU_FPV5_SP_D16})
    set(GCC_M_FPU fpv5-sp-d16)
elseif(${CONFIG_TARGET_ARM_FPU_FPV5_DP_D16})
    set(GCC_M_FPU fpv5-d16)
else()
    set(GCC_M_FPU auto)
endif()

# set(GCC_M_FPU fpv4)

set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_SYSTEM_NAME Generic)

set(ARM_GCC_FLAGS "")

if(GCC_M_CPU)
    set(ARM_GCC_FLAGS "${ARM_GCC_FLAGS} -mcpu=${GCC_M_CPU}")
endif()

if(GCC_M_ARCH)
    set(ARM_GCC_FLAGS "${ARM_GCC_FLAGS} -march=${GCC_M_ARCH}")
endif()

if(GCC_M_FPU)
    set(ARM_GCC_FLAGS "${ARM_GCC_FLAGS} -mfpu=${GCC_M_FPU}")
endif()

if(${CONFIG_TARGET_NO_FPU})
    set(ARM_GCC_FLAGS "${ARM_GCC_FLAGS} -mfloat-abi=soft")
else()
    set(ARM_GCC_FLAGS "${ARM_GCC_FLAGS} -mfloat-abi=hard")
endif()

# TODO: DSP Extension, other extensions
set(CMAKE_C_FLAGS "-nostdlib --specs=nosys.specs ${ARM_GCC_FLAGS} -fdata-sections -ffunction-sections -Wl,--gc-sections" CACHE INTERNAL "")
set(CMAKE_CXX_FLAGS "-nostdlib ${APP_CXX_FLAGS} ${CMAKE_C_FLAGS} -fno-exceptions" CACHE INTERNAL "")

include(${CMAKE_CURRENT_LIST_DIR}/gcc-common.cmake)
